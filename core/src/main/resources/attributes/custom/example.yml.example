# 自定义属性模板：将本文件复制或重命名为 *.yml 后会作为自定义属性加载
# （放在 config.yml 的 attributes.custom-directory 指定的目录，默认 attributes/custom/）。
# 可在文件顶层加一行 `namespace: 某命名空间` 为本文件的属性指定命名空间，缺省使用 config.yml 中的 renova。

# 属性的内部 ID（命名空间内的稳定键）：仅限小写字母、数字、点、连字符；代码与公式通过它引用本属性。
internal: cooldown-reduction
# 显示名：装备 Lore 匹配（替换 lore_patterns.yml 中的 {name}）与 /ra info 显示使用。
display-name: '冷却缩减'
# 分类，6 选 1：VITAL / PHYSICAL / MAGIC / OFFENSE / DEFENSE / UTILITY。
category: UTILITY
# 无任何来源贡献时的默认值。
default-value: 0.0
# 数值下限：最终值会被钳制，低于该值时取该值。
min-value: 0.0
# 数值上限：0.9 表示最高 90%（format 为 PERCENT 时内部 0.9 = 显示 90%）。
max-value: 0.9
# 展示格式：NUMBER = 数值；PERCENT = 百分比（显示时数值 * 100 加 %）。
format: PERCENT
# Lore 中「显示名: 数值」（无标签）默认按哪种修饰模式计入：BASE / FLAT / PERCENT / MULTIPLY。
lore-mode: FLAT
# Lore 中的数字是否按百分比解读：true 时写 15 表示 0.15。
lore-percent-value: true
# 公式依赖的属性列表：保证被依赖属性先于本公式计算（按依赖关系拓扑排序，不允许循环依赖）。
# 必须写全名「命名空间:属性id」。
depends-on:
  - renova:max-mana
# Lua 计算公式：编译为 function(context)，必须 return 一个数字。
# 可用成员：context.base / context.flat / context.percent / context.multiplier（本次各段贡献）、
#           context.current（本属性按五段公式结算后的当前值）、
#           context.get('属性键')（读取其他属性的最终值，查不到返回 0.0）。
# 沙盒限制：禁用 os/io/luajava 等，math/string/table 只读，单次执行指令数见 config.yml lua 段。
formula: |
  local mana = context.get('renova:max-mana')
  return math.min(0.9, context.current + mana * 0.0005)
